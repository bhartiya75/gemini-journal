rules_version = '2';
// Clients never touch Firestore directly — all access goes through the
// authenticated server API, which scopes every operation to the verified
// caller's users/{uid} subtree. Deny everything at the client layer.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
